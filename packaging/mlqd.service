# systemd unit for the mlq scheduler daemon.
#
# Install:
#   sudo useradd -r -m -d /var/lib/mlq -s /usr/bin/nologin mlq
#   sudo loginctl enable-linger mlq            # rootless podman needs a user session
#   sudo cp target/release/mlqd target/release/mlq /usr/local/bin/
#   sudo mkdir -p /etc/mlq && sudo cp packaging/mlq.toml /etc/mlq/mlq.toml   # then edit it
#   sudo cp packaging/mlqd.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mlqd
#   sudo cat /var/lib/mlq/admin.token        # first admin token
#
# The daemon runs as the unprivileged `mlq` user and starts job containers with rootless
# podman, so a container escape yields only that account.

[Unit]
Description=mlq GPU job scheduler
After=network-online.target remote-fs.target
Wants=network-online.target
# If datasets/archive live on NFS, start after the mount:
# RequiresMountsFor=/mnt/nas

[Service]
Type=simple
User=mlq
Group=mlq
Environment=MLQ_CONFIG=/etc/mlq/mlq.toml
# Rootless podman needs XDG_RUNTIME_DIR to find its socket/state.
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/usr/local/bin/mlqd --config /etc/mlq/mlq.toml
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=60
# Hardening (job containers are children of podman, not of this service's cgroup, so these
# limits apply to the daemon itself only).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/mlq /mnt/nas/mlq-results

[Install]
WantedBy=multi-user.target
