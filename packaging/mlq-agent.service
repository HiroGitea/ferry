# systemd unit for an mlq compute agent (a machine that runs jobs for a control node elsewhere).
#
# Install on the compute machine:
#   sudo useradd -r -m -d /var/lib/mlq -s /usr/bin/nologin mlq && sudo loginctl enable-linger mlq
#   sudo cp target/release/mlqd /usr/local/bin/
#   sudo mkdir -p /etc/mlq && sudo cp packaging/mlq-agent.toml /etc/mlq/mlq.toml   # then edit it
#   sudo cp packaging/mlq-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mlq-agent
#
# The agent only needs to reach the control node (e.g. over tailscale) and to be reachable
# from it on `agent.listen`.

[Unit]
Description=mlq compute agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=mlq
Group=mlq
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/usr/local/bin/mlqd --agent --config /etc/mlq/mlq.toml
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/mlq

[Install]
WantedBy=multi-user.target
